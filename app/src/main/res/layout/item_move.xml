<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardMoveItem"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_pokeinfo_pill"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <TextView
        android:id="@+id/tvMoveLevel"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:text="Nv. 36"
        android:textColor="#CBD5E1"
        android:textSize="12sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/tvMoveName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Shuriken de Agua"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/tvMoveType"
        android:layout_width="76dp"
        android:layout_height="26dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_pokeinfo_pill"
        android:gravity="center"
        android:text="WATER"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        app:backgroundTint="@color/type_water" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />
</LinearLayout>